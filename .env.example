# ==============================================================================
# AI Adaptive Interview Coach - Environment Configuration (.env.example)
# AWS Innovation Challenge 2026
#
# IMPORTANT SECURITY RULES:
# 1. Never put AWS Access Key ID or Secret Access Keys in frontend code.
# 2. Use least-privilege IAM roles and Cognito JWT claims for all client calls.
# 3. For local evaluation without live AWS deployment, set VITE_DEMO_MODE=true.
# ==============================================================================

# ------------------------------------------------------------------------------
# BACKEND & AWS LAMBDA CONFIGURATION
# ------------------------------------------------------------------------------
AWS_REGION=us-east-1

# Amazon Bedrock Model ID (Runtime Converse API)
# Recommended: anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-pro-v1:0
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Amazon Bedrock Guardrails (Optional content and fairness filter)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# Amazon DynamoDB Single-Table Name
DYNAMODB_TABLE=ai-interview-coach-table

# Amazon S3 Document & Voice Bucket
DOCUMENT_BUCKET=ai-interview-coach-docs-123456789012-us-east-1

# Agentic AI Orchestration Toggle (true = AgentCore tool calling; false = deterministic engine)
AGENTIC_MODE=true

# Amazon Polly Voice ID (e.g. Ruth, Joanna, Matthew, Stephen)
POLLY_VOICE_ID=Ruth

# Max question budget cap
MAX_INTERVIEW_QUESTIONS=12

# CloudWatch Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO


# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vite SPA)
# ------------------------------------------------------------------------------
# Base URL of Amazon API Gateway HTTP API endpoint output by CDK
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com

# AWS Deployment Region for Cognito User Pool
VITE_AWS_REGION=us-east-1

# Amazon Cognito Authentication credentials
VITE_COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
VITE_COGNITO_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Hackathon Live Debug Telemetry Panel (true = expand engine telemetry by default)
VITE_DEMO_DEBUG=true

# Offline Demo Mode Toggle (true = uses seeded local data if AWS is unconfigured)
VITE_DEMO_MODE=false
